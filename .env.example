# ═══════════════════════════════════════════════════════════════
#  Corporate Law Assistant — Environment Variables
# ═══════════════════════════════════════════════════════════════

# ── LLM Provider ─────────────────────────────────────────────
# Supported: ollama, openai, groq, together
LLM_PROVIDER=groq

# -- Ollama (local dev) ----------------------------------------
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=mistral

# -- API-based (production) — fill for your provider -----------
LLM_API_KEY=your_groq_api_key_here
# LLM_API_BASE=                          # auto-detected per provider
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.2

# ── Embedding Model ──────────────────────────────────────────
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# ── Text Splitter ────────────────────────────────────────────
CHUNK_SIZE=1500
CHUNK_OVERLAP=300

# ── Retriever ────────────────────────────────────────────────
RETRIEVER_K=8

# ── Supabase Auth (optional — leave blank to disable auth) ───
# Get these from your Supabase project dashboard:
#   https://supabase.com/dashboard → Settings → API
SUPABASE_URL=https://aaqsthzbvehxzojqoztd.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImFhcXN0aHpidmVoeHpvanFvenRkIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODM4Mzc4MTEsImV4cCI6MjA5OTQxMzgxMX0.CoRFJ83RodFbzv6Fmi9YIGW05QC88aO6m_ALJzkIWvo
SUPABASE_JWT_SECRET=P6LHnaIa1IjNZzJDnanOdrIhcmDL428fHg2VtQMf6IwXqEA+68gfP6jI5jGKncStofb57kMHncqobyNAZRd3mQ==

# ── CORS (comma-separated origins) ──────────────────────────
# Leave blank for local dev; set to your deployment URL in production
# ALLOWED_ORIGINS=https://rag-legal-assistant.onrender.com

# ── Auto-Ingest (set to 0 to disable) ───────────────────────
SCRAPE_URL=
AUTO_INGEST_INTERVAL_HOURS=0

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
