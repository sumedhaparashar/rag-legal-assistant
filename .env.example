# ═══════════════════════════════════════════════════════════════
#  Corporate Law Assistant — Environment Variables
# ═══════════════════════════════════════════════════════════════

# ── LLM Provider ─────────────────────────────────────────────
# Supported: ollama, openai, groq, together
LLM_PROVIDER=groq

# -- Ollama (local dev) ----------------------------------------
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=mistral

# -- API-based (production) — fill for your provider -----------
LLM_API_KEY=your_groq_api_key_here
# LLM_API_BASE=                          # auto-detected per provider
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.2

# ── Embedding Model ──────────────────────────────────────────
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# ── Text Splitter ────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ── Retriever ────────────────────────────────────────────────
RETRIEVER_K=5

# ── Supabase Auth (optional — leave blank to disable auth) ───
# Get these from your Supabase project dashboard:
#   https://supabase.com/dashboard → Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# ── CORS (comma-separated origins) ──────────────────────────
# Leave blank for local dev; set to your deployment URL in production
# ALLOWED_ORIGINS=https://rag-legal-assistant.onrender.com

# ── Auto-Ingest (set to 0 to disable) ───────────────────────
SCRAPE_URL=
AUTO_INGEST_INTERVAL_HOURS=0

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
